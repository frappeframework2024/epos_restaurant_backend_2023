<!doctype html>
<html lang="km">
<head>
  <meta charset="utf-8">
  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      background: #fff;
      color: #000;
    }

    body {
      width: 576px;
      padding: 10px;
      font-family: "Khmer OS Battambang", "Khmer OS", "Noto Sans Khmer", Arial, sans-serif;
      font-size: 28px;
      line-height: 1.3;
    }

    .center {
      text-align: center;
    }

    .shop-name {
      font-size: 40px;
      font-weight: 700;
      line-height: 1.25;
    }

    .small {
      font-size: 24px;
    }

    .line {
      border-top: 2px dashed #000;
      margin: 10px 0;
    }

    .info-row,
    .summary-row {
      display: flex;
      justify-content: space-between;
      gap: 10px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      font-size: 24px;
    }

    th,
    td {
      padding: 7px 1px;
      vertical-align: top;
      border-bottom: 1px dotted #000;
      overflow-wrap: anywhere;
    }

    th {
      font-size: 26px;
      font-weight: 700;
      text-align: left;
      border-bottom: 2px solid #000;
    }

    .description {
      width: 206px;
    }

    .qty {
      width: 52px;
      text-align: center;
    }

    .price,
    .discount,
    .amount {
      text-align: right;
    }

    .price {
      width: 86px;
    }

    .discount {
      width: 68px;
    }

    .amount {
      width: 100px;
    }

    .summary {
      margin-top: 8px;
      font-size: 28px;
    }

    .total {
      font-size: 36px;
      font-weight: 700;
      border-top: 2px solid #000;
      padding-top: 6px;
      margin-top: 6px;
    }

    .footer {
      margin-top: 14px;
      font-size: 25px;
    }
  </style>
</head>
<body>
  <div class="center">
    <div class="shop-name">ហាងលក់ទំនិញ សុខសាន្ត</div>
    <div class="small">ផ្ទះលេខ ១២៣ ផ្លូវព្រះសីហនុ ភ្នំពេញ</div>
    <div class="small">ទូរស័ព្ទ: 012 345 678</div>
  </div>

  <div class="line"></div>

  <div class="info-row small">
    <span>វិក្កយបត្រ: INV-0001</span>
    <span>តុ: A01</span>
  </div>
  <div class="info-row small">
    <span>កាលបរិច្ឆេទ: 15-06-2026</span>
    <span>អ្នកលក់: ដារ៉ា</span>
  </div>

  <div class="line"></div>

  <table>
    <thead>
      <tr>
        <th class="description">បរិយាយ</th>
        <th class="qty">ចំនួន</th>
        <th class="price">តម្លៃ</th>
        <th class="discount">បញ្ចុះ</th>
        <th class="amount">សរុប</th>
      </tr>
    </thead>
    <tbody>
      <tr><td class="description">បាយសាច់ជ្រូក</td><td class="qty">1</td><td class="price">2.50</td><td class="discount">0.00</td><td class="amount">2.50</td></tr>
      <tr><td class="description">បាយមាន់អាំង</td><td class="qty">2</td><td class="price">3.00</td><td class="discount">0.50</td><td class="amount">5.50</td></tr>
      <tr><td class="description">មីឆាសាច់គោ</td><td class="qty">1</td><td class="price">3.50</td><td class="discount">0.00</td><td class="amount">3.50</td></tr>
      <tr><td class="description">គុយទាវសាច់គោ</td><td class="qty">1</td><td class="price">3.00</td><td class="discount">0.00</td><td class="amount">3.00</td></tr>
      <tr><td class="description">ស៊ុបមាន់</td><td class="qty">1</td><td class="price">4.00</td><td class="discount">0.00</td><td class="amount">4.00</td></tr>
      <tr><td class="description">ត្រីអាំង</td><td class="qty">1</td><td class="price">5.00</td><td class="discount">0.50</td><td class="amount">4.50</td></tr>
      <tr><td class="description">ឆាក្តៅសាច់ជ្រូក</td><td class="qty">1</td><td class="price">3.25</td><td class="discount">0.00</td><td class="amount">3.25</td></tr>
      <tr><td class="description">បន្លែឆា</td><td class="qty">2</td><td class="price">2.00</td><td class="discount">0.00</td><td class="amount">4.00</td></tr>
      <tr><td class="description">ពងទាចៀន</td><td class="qty">1</td><td class="price">1.50</td><td class="discount">0.00</td><td class="amount">1.50</td></tr>
      <tr><td class="description">នំប៉័ងសាច់</td><td class="qty">2</td><td class="price">1.25</td><td class="discount">0.00</td><td class="amount">2.50</td></tr>
      <tr><td class="description">កាហ្វេទឹកកក</td><td class="qty">2</td><td class="price">1.50</td><td class="discount">0.00</td><td class="amount">3.00</td></tr>
      <tr><td class="description">តែទឹកកក</td><td class="qty">1</td><td class="price">1.00</td><td class="discount">0.00</td><td class="amount">1.00</td></tr>
      <tr><td class="description">ទឹកក្រូច</td><td class="qty">2</td><td class="price">1.25</td><td class="discount">0.00</td><td class="amount">2.50</td></tr>
      <tr><td class="description">ទឹកសុទ្ធ</td><td class="qty">3</td><td class="price">0.50</td><td class="discount">0.00</td><td class="amount">1.50</td></tr>
      <tr><td class="description">នំគ្រក់</td><td class="qty">1</td><td class="price">1.50</td><td class="discount">0.00</td><td class="amount">1.50</td></tr>
      <tr><td class="description">នំអន្សម</td><td class="qty">2</td><td class="price">1.00</td><td class="discount">0.00</td><td class="amount">2.00</td></tr>
      <tr><td class="description">ផ្លែឈើចម្រុះ</td><td class="qty">1</td><td class="price">2.50</td><td class="discount">0.00</td><td class="amount">2.50</td></tr>
      <tr><td class="description">ទឹកដោះគោ</td><td class="qty">1</td><td class="price">1.75</td><td class="discount">0.00</td><td class="amount">1.75</td></tr>
      <tr><td class="description">កាបូបក្រដាស</td><td class="qty">1</td><td class="price">0.25</td><td class="discount">0.00</td><td class="amount">0.25</td></tr>
      <tr><td class="description">សេវាកម្មដឹកជញ្ជូន</td><td class="qty">1</td><td class="price">1.00</td><td class="discount">0.00</td><td class="amount">1.00</td></tr>
    </tbody>
  </table>

  <div class="summary">
    <div class="summary-row"><span>សរុបរង</span><span>$51.00</span></div>
    <div class="summary-row"><span>បញ្ចុះតម្លៃ</span><span>$1.00</span></div>
    <div class="summary-row"><span>ពន្ធ</span><span>$0.00</span></div>
    <div class="summary-row total"><span>សរុបចុងក្រោយ</span><span>$50.00</span></div>
  </div>

  <div class="line"></div>

  <div class="center footer">
    <div>សូមអរគុណ!</div>
    <div>សូមអញ្ជើញមកម្តងទៀត</div>
  </div>
</body>
</html>
